/* Global Base */
QWidget {
    font-family: "Inter", "Segoe UI", -apple-system, sans-serif;
    font-size: 13px;
    color: #111827;
}

QMainWindow, QDialog {
    background-color: #f4f7f7;
}

/* Sidebar Navigation */
#Sidebar {
    background-color: #0b3d3b;
    min-width: 230px;
    max-width: 230px;
}

#SidebarBrand {
    color: #ffffff;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 18px 16px 4px 16px;
}

#SidebarRole {
    color: #14b8a6;
    font-size: 11px;
    font-weight: 700;
    padding: 0px 16px 16px 16px;
}

QPushButton[class="nav-btn"] {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.82);
    text-align: left;
    padding: 11px 16px;
    border: none;
    border-radius: 6px;
    margin: 2px 10px;
    font-weight: 600;
}

QPushButton[class="nav-btn"]:hover {
    background-color: rgba(255, 255, 255, 0.10);
    color: #ffffff;
}

QPushButton[class="nav-btn"][active="true"] {
    background-color: #0f6b66;
    color: #ffffff;
    border-left: 3px solid #14b8a6;
}

/* Cards & Panels */
QFrame[class="card"] {
    background-color: #ffffff;
    border: 1px solid #dce5e5;
    border-radius: 10px;
}

QLabel[class="page-title"] {
    font-size: 20px;
    font-weight: 800;
    color: #0b3d3b;
}

QLabel[class="section-title"] {
    font-size: 14px;
    font-weight: 700;
    color: #111827;
}

QLabel[class="kpi-label"] {
    font-size: 11px;
    font-weight: 700;
    color: #4b5563;
}

QLabel[class="kpi-value"] {
    font-size: 26px;
    font-weight: 800;
    color: #0b3d3b;
}

/* Buttons */
QPushButton[class="btn-primary"] {
    background-color: #0f6b66;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton[class="btn-primary"]:hover {
    background-color: #0a5450;
}

QPushButton[class="btn-accent"] {
    background-color: #14b8a6;
    color: #052e2b;
    border: none;
    border-radius: 6px;
    padding: 8px 14px;
    font-weight: 700;
}

QPushButton[class="btn-outline"] {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 14px;
    font-weight: 600;
}

QPushButton[class="btn-outline"]:hover {
    border-color: #0f6b66;
    color: #0f6b66;
    background-color: #e6f4f3;
}

QPushButton[class="btn-danger"] {
    background-color: #fee2e2;
    color: #b91c1c;
    border: 1px solid #fca5a5;
    border-radius: 6px;
    padding: 7px 14px;
    font-weight: 600;
}

QPushButton[class="btn-danger"]:hover {
    background-color: #fecaca;
}

/* Inputs & Tables */
QLineEdit, QComboBox, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 10px;
}

QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #0f6b66;
}

QTableWidget {
    background-color: #ffffff;
    border: 1px solid #dce5e5;
    border-radius: 8px;
    gridline-color: #eef2f2;
    selection-background-color: #e6f4f3;
    selection-color: #0b3d3b;
}

QHeaderView::section {
    background-color: #f8fafa;
    color: #4b5563;
    font-weight: 700;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #dce5e5;
}

/* Fix QComboBox & Dropdown Popup Visibility on macOS/Windows */
QComboBox {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 7px 10px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #cbd5e1;
    selection-background-color: #e6f4f3;
    selection-color: #0b3d3b;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    background-color: #ffffff;
    color: #111827;
    padding: 6px 10px;
    min-height: 24px;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: #e6f4f3;
    color: #0b3d3b;
}